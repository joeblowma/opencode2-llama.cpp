{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-plugin-llama.cpp",
  "version": "0.2.0",
  "description": "OpenCode plugin for enhanced llama.cpp support with auto-detection and dynamic model discovery",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "src",
    "index.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "build": "pnpm run typecheck && pnpm run test:run",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run test:run",
    "validate:config": "node scripts/validate-config.ts",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "opencode",
    "llama-cpp",
    "plugin",
    "local-llm",
    "openai-compatible"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llessi06/opencode-llama.cpp.git"
  },
  "dependencies": {
    "@opencode/plugin": "latest",
    "opencode-plugin-llama.cpp": "link:",
    "strip-json-comments": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
